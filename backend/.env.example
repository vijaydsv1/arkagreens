# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173

# SMTP credentials for outbound notification emails.
# Until these are set, the API still works and stores submissions in the
# database -- it just logs a warning instead of sending an email.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FROM_EMAIL=
TO_EMAIL=arkagreens99@gmail.com

# Port for `uvicorn app.main:app --port <PORT>` -- 8000 is the usual default,
# but pick a free port on your machine (frontend's VITE_API_URL must match).
PORT=8001
